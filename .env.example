# Copier vers .env pour surcharger les valeurs par défaut de docker-compose.yml
SOURCE_MODE=soda
START_DATE=2023-01-01
END_DATE=2023-01-15
MAX_ROWS_PER_DAY=0
# Optionnel : un app token Socrata augmente fortement les quotas (https://data.cityofchicago.org/profile/edit/developer_settings)
SODA_APP_TOKEN=
SPARK_DRIVER_MEMORY=2g
REJECT_RATIO_THRESHOLD=0.10
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
